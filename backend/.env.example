# AgroShield AI - Backend Environment Configuration

# Application
APP_NAME="AgroShield AI"
APP_VERSION="1.0.0"
API_PREFIX="/api"

# Security (Generate a secure random string in production, e.g., using `openssl rand -hex 32`)
SECRET_KEY="replace_with_a_secure_random_jwt_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed CORS Origins (comma-separated URLs of deployed frontends)
# Example: https://agroshield.vercel.app,https://your-custom-domain.com
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000"

# Database Connection URL
# For SQLite (default local development):
DATABASE_URL="sqlite:///./agroshield.db"
# For PostgreSQL (Render, Neon, Supabase, AWS RDS):
# DATABASE_URL="postgresql://user:password@hostname:5432/agroshield"

# AI Thresholds
CONFIDENCE_THRESHOLD=0.70
BLUR_THRESHOLD=45.0
MIN_RESOLUTION=150

# Mode
DEMO_MODE=True
